{
  "name": "totem-enforce",
  "version": "0.5.1",
  "description": "Enforces totem-first workflow: memory gates + register-after-read/write commit-gates",
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": ".*",
      "command": "python3 ./hooks/totem-hook.py pre",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
      "command": "python3 ./hooks/totem-hook.py post",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/totem-hook.py clear",
      "timeout": 5
    }
  ],
  "interface": {
    "displayName": "Totem Enforcement",
    "shortDescription": "Forces totem-first workflow via tool call interception"
  }
}
